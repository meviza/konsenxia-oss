# KONSENXIA Backend - Environment Variables
# Copy to .env and fill in values

# Server
NODE_ENV=development
PORT=3000
HOST=0.0.0.0

# Firebase (Firestore) - Cloud database
# Option A: Service account JSON file path (recommended for local dev)
GOOGLE_APPLICATION_CREDENTIALS=./service-account.json

# Option B: Individual env vars (for production/CI)
# Get these from Firebase Console > Project Settings > Service Accounts > Generate new private key
# FIREBASE_PROJECT_ID=your-project-id
# FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Upstash Redis (opsiyonel - yoksa in-memory kullanılır)
# Create free database at https://console.upstash.com/
# UPSTASH_REDIS_REST_URL=https://xxx.upstash.io
# UPSTASH_REDIS_REST_TOKEN=your-upstash-token

# JWT (required for auth)
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=24h
JWT_REFRESH_EXIRES_IN=7d

# AI (Gemini - required for AI features)
GEMINI_API_KEY=

# CORS (comma-separated origins)
CORS_ORIGINS=http://localhost:3000,http://localhost:8081
